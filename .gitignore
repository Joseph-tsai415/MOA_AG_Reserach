.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json

# Skill reference-data caches — large downloadable flat files, NOT source.
# Re-fetch with each skill's own downloader, e.g.
#   python .claude/skills/mirna-targets/scripts/download_reference_data.py
# hsa_MTI.csv alone is ~322 MB, well over GitHub's 100 MB per-file limit.
.claude/skills/*/data/

# Run output — regenerated by the pipeline, not source.
# NOTE: this also excludes the per-run scripts/ inside them. That is intended:
# per-run drivers are run-specific and CLAUDE.md §8 requires them to `import
# moa_lib`. Anything genuinely reusable therefore belongs in moa_lib/ — if you
# find yourself writing a helper in a run folder that a future run would want,
# promote it to moa_lib/ first, or it is lost the moment the folder is cleaned.
results/
reviews/
reviews_archive/

# Transient artifacts, regenerated on every run:
#   _pdf_preview/  PNG page renders from `build_report_pdf.py --verify`
#   geo_tmp/       GEOparse SOFT/matrix download cache
#   tool-results/  raw fetch dumps from web/PDF retrieval steps
_pdf_preview/
geo_tmp/
tool-results/

# Logs
*.log
