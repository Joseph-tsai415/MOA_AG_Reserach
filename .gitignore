# Skill reference-data caches — large downloadable flat files, NOT source.
# Re-fetch with each skill's own downloader, e.g.
#   python .claude/skills/mirna-targets/scripts/download_reference_data.py
# hsa_MTI.csv alone is ~322 MB, well over GitHub's 100 MB per-file limit.
.claude/skills/*/data/

# Results (regenerated by the pipeline)
results/

# Transient artifacts, regenerated on every run:
#   _pdf_preview/  PNG page renders from `build_report_pdf.py --verify`
#   geo_tmp/       GEOparse SOFT/matrix download cache
#   tool-results/  raw fetch dumps from web/PDF retrieval steps
_pdf_preview/
geo_tmp/
tool-results/

# Logs
*.log
